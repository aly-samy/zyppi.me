{
  "name": "@zyppi/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "zyppi": {
    "layer": "runtime"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/pipeline.js": {
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    },
    "./dist/types.js": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "boundary": "node ../../tools/verify-package-boundary.mjs --package=packages/runtime"
  },
  "dependencies": {
    "@zyppi/domain": "workspace:*",
    "@zyppi/shared": "workspace:*"
  },
  "peerDependencies": {}
}
