{
  "name": "zyppi-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "registry:seed": "pnpm build && node apps/api/dist/registry/seed/seed-cli.js",
    "db:migrate": "pnpm --filter @zyppi/infra build && node infra/dist/cli.js migrate",
    "db:status": "pnpm --filter @zyppi/infra build && node infra/dist/cli.js status",
    "db:verify": "pnpm --filter @zyppi/infra build && node infra/dist/cli.js verify",
    "test": "vitest run",
    "test:replay": "pnpm -r test:replay",
    "test:conformance": "pnpm -r test:conformance",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern \"**/dist/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "pnpm -r bench",
    "runtime:purity": "node tools/validate-runtime-purity.mjs",
    "runtime:boundary": "node tools/verify-package-boundary.mjs --package=packages/runtime",
    "domain:boundary": "node tools/verify-package-boundary.mjs --package=packages/domain",
    "contracts:boundary": "node tools/verify-package-boundary.mjs --package=packages/contracts",
    "shared:boundary": "node tools/verify-package-boundary.mjs --package=packages/shared",
    "testing:boundary": "node tools/verify-package-boundary.mjs --package=packages/testing",
    "boundary:all": "pnpm --recursive --if-present run boundary",
    "graph:validate": "node tools/verify-dependency-graph.mjs",
    "ci": "pnpm format:check && pnpm lint && pnpm exec tsc -b && pnpm runtime:purity && pnpm boundary:all && pnpm graph:validate && pnpm test",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "20.19.0"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "2.32.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
